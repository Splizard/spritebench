[configuration]

entry_symbol = "godot_entry_init"
compatibility_minimum = "4.5"

[libraries]
linux.debug = "res://bin/libgdexample.so"
linux.release = "res://bin/libgdexample.so"
windows.debug = "res://bin/libgdexample.dll"
windows.release = "res://bin/libgdexample.dll"
macos.release = "res://bin/libgdexample.dylib"
macos.debug = "res://bin/libgdexample.dylib"
android.debug.arm64 = "res://bin/android/libgdexample.so"
android.release.arm64 = "res://bin/android/libgdexample.so"
ios.arm64 = "res://bin/ios/libgdexample.dylib"
ios.debug.arm64 = "res://bin/ios/libgdexample.dylib"
ios.release.arm64 = "res://bin/ios/libgdexample.dylib"