# Copy to bench/.env (gitignored) and fill in for your machines.
# ssh host of the Mac used by run-macos.sh / run-ios.sh (user@host or host)
SPRITEBENCH_MAC_HOST=
# ssh host of the Windows machine used by run-windows.sh (needs admin account)
SPRITEBENCH_WIN_HOST=
# Apple developer team id used to sign iOS builds (stamped into the export
# presets on the Mac at build time; the tracked presets carry none)
IOS_TEAM=
# Password of the dedicated spritebench.keychain on the Mac (see bench/README)
IOS_KEYCHAIN_PW=
