[configuration]

entry_symbol = "SpriteBenchCpp_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/linux/libSpriteBenchCpp.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/linux/libSpriteBenchCpp.linux.template_release.x86_64.so"
macos.debug.arm64 = "res://bin/macos/libSpriteBenchCpp.macos.template_release.arm64.dylib"
macos.release.arm64 = "res://bin/macos/libSpriteBenchCpp.macos.template_release.arm64.dylib"
android.debug.arm64 = "res://bin/android/libSpriteBenchCpp.android.template_release.arm64.so"
android.release.arm64 = "res://bin/android/libSpriteBenchCpp.android.template_release.arm64.so"
ios.arm64 = "res://bin/ios/libSpriteBenchCpp.ios.template_release.arm64.dylib"
ios.release.arm64 = "res://bin/ios/libSpriteBenchCpp.ios.template_release.arm64.dylib"
ios.debug.arm64 = "res://bin/ios/libSpriteBenchCpp.ios.template_release.arm64.dylib"
windows.debug.x86_64 = "res://bin/windows/SpriteBenchCpp.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/windows/SpriteBenchCpp.windows.template_release.x86_64.dll"
web.release.wasm32 =     "res://bin/web/libSpriteBenchCpp.web.template_release.wasm32.wasm"
web.debug.wasm32 =     "res://bin/web/libSpriteBenchCpp.web.template_debug.wasm32.wasm"