[configuration]

entry_symbol = "SpriteBenchCpp_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/linux/libSpriteBenchCpp.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/linux/libSpriteBenchCpp.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/windows/libSpriteBenchCpp.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/windows/libSpriteBenchCpp.windows.template_release.x86_64.dll"
web.release.wasm32 =     "res://bin/web/libSpriteBenchCpp.web.template_release.wasm32.wasm"
web.debug.wasm32 =     "res://bin/web/libSpriteBenchCpp.web.template_debug.wasm32.wasm"