[configuration]
entry_symbol = "swift_entry_point"
compatibility_minimum = 4.6

[libraries]
macos.debug = "res://addons/swift_godot_extension/bin/arm64-apple-macosx/release/libSpriteBenchSwift.dylib"
macos.release = "res://addons/swift_godot_extension/bin/arm64-apple-macosx/release/libSpriteBenchSwift.dylib"
