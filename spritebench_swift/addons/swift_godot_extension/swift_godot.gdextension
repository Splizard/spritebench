ios.arm64 = {"res://addons/swift_godot_extension/bin/arm64-apple-ios/release/SwiftGodot.framework": "", "res://addons/swift_godot_extension/bin/arm64-apple-ios/release/SwiftGodotRuntime.framework": ""}
linux.debug.x86_64 = {"res://addons/swift_godot_extension/bin/x86_64-unknown-linux-gnu/debug/libSwiftGodot.so": ""}
linux.release.x86_64 = {"res://addons/swift_godot_extension/bin/x86_64-unknown-linux-gnu/release/libSwiftGodot.so": ""}
windows.debug.x86_64 = {"res://addons/swift_godot_extension/bin/x86_64-unknown-windows-msvc/debug/SwiftGodot.dll": ""}
